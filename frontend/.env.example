# URL de la API FastAPI (Módulo A). Sin valor, la app usa los datos mock.
VITE_API_URL=http://localhost:8000

# true = usar siempre los datos mock aunque haya VITE_API_URL.
VITE_USE_MOCKS=true

# Clave pública de Clerk (Dashboard de Clerk > API Keys > Publishable key).
# Sin valor, la app arranca en modo demo, sin login.
VITE_CLERK_PUBLISHABLE_KEY=
