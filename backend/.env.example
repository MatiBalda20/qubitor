# Copiar a backend/.env y completar. Nunca commitear valores reales.

# Conexión Redis de Upstash (TCP con TLS, no la REST): la usan la API y el scan-worker.
REDIS_URL=rediss://default:CONTRASEÑA@tu-base.upstash.io:6379

# Orígenes del frontend permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

# Caché de OSV en Cloudflare Workers KV (Módulo D). Sin estas variables se consulta OSV directo.
# Workers KV → crear el namespace; My Profile → API Tokens → token con "Workers KV Storage: Edit".
CF_ACCOUNT_ID=tu-account-id
CF_KV_NAMESPACE_ID=tu-namespace-id
CF_API_TOKEN=tu-api-token
# Reportes en Cloudflare R2 (Módulo D). Sin estas variables los reportes no se guardan.
# R2 → Manage R2 API Tokens: crear un token con permiso de lectura y escritura sobre el bucket.
R2_ACCOUNT_ID=tu-account-id
R2_ACCESS_KEY_ID=tu-access-key-id
R2_SECRET_ACCESS_KEY=tu-secret-access-key
R2_BUCKET=qubitor-reportes
# Opcional: otro servicio S3-compatible para probar en local (por ejemplo MinIO).
# R2_ENDPOINT=http://localhost:9000
# Clerk: URL del emisor de los tokens (Clerk > API Keys > Frontend API URL). No es un secreto.
CLERK_ISSUER=https://tu-instancia.clerk.accounts.dev

# Solo en local, con el frontend en modo demo (sin Clerk). Nunca en Render.
AUTH_DISABLED=false
# Conexión a Supabase por el pooler (puerto 6543). Sin esta variable, el worker solo registra
# los resultados en el log: descomentarla recién con la URL real, o todos los escaneos van a fallar.
# DATABASE_URL=postgresql+psycopg://postgres.PROYECTO:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:6543/postgres

# Integración con GitHub (Módulo E). Clerk > API Keys > Secret key. ES UN SECRETO: solo en Render.
# La API la usa para listar los repos del usuario; el worker, solo si GITHUB_PRIVATE_REPOS=true.
CLERK_SECRET_KEY=sk_test_tu-clave-secreta
# Opcional: nombre del proveedor en Clerk si no es oauth_github ni github.
# CLERK_GITHUB_PROVIDER=oauth_github
# Repos privados: el worker pide a Clerk el token de quien conectó el repo. Dejar en false
# hasta que el motor SAST ejecute Bandit aislado (ver correcciones de seguridad).
GITHUB_PRIVATE_REPOS=false
