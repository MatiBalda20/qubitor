# Copiar a backend/.env y completar. Nunca commitear valores reales.

# Conexión Redis de Upstash (TCP con TLS, no la REST): la usan la API y el scan-worker.
REDIS_URL=rediss://default:CONTRASEÑA@tu-base.upstash.io:6379

# Orígenes del frontend permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

# Conexión a Supabase por el pooler (puerto 6543). Sin valor, el worker solo registra los resultados en el log.
DATABASE_URL=postgresql+psycopg://postgres.PROYECTO:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:6543/postgres
