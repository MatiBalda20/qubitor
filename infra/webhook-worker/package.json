{
  "name": "qubitor-webhook-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cloudflare Worker que recibe los webhooks de push de GitHub y pide un escaneo a la API de Qubitor (Módulo E).",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --include-runtime=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "typescript": "~5.8.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
